// ═══════════════════════════════════════════════════
// Config.xcconfig
// Single source of truth for version & build number.
// Edit ONLY this file before each TestFlight deploy.
// ═══════════════════════════════════════════════════

MARKETING_VERSION = 1.3
CURRENT_PROJECT_VERSION = 168

// Supabase diagnostic endpoint defaults. Production session uploads use the
// signed-in user's JWT and never embed an administrative upload credential.
// `$()` expands to an empty string and keeps `https://` from being parsed as a comment.
SPOTEQ_CLOUD_BASE_URL = https:/$()/vvowvcdylztsqpzifdqc.supabase.co
SPOTEQ_CLOUD_LOG_PATH = /functions/v1/calib-log

// Supabase Auth — anon (public) key.
// Replace with the value from Supabase Dashboard → Settings → API → "anon public".
SPOTEQ_SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY_HERE
